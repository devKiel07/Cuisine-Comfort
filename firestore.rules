rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'ezekieltagoe20@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function validMenuItem(itemId) {
      let data = request.resource.data;
      return data.keys().hasAll(['c', 'k', 'n', 'd', 'p'])
        && data.keys().hasOnly(['c', 'k', 'n', 'd', 'p', 't', 'image', 'sortOrder'])
        && data.k == itemId
        && data.k is string
        && data.k.size() > 0
        && data.k.size() <= 60
        && data.c in ['Snacks', 'Mains', 'Sides', 'Drinks']
        && data.n is string
        && data.n.size() > 0
        && data.n.size() <= 100
        && data.d is string
        && data.d.size() <= 400
        && data.p is number
        && data.p > 0
        && data.p <= 100000
        && (!data.keys().hasAny(['t']) || (data.t is string && data.t.size() <= 40))
        && (!data.keys().hasAny(['image']) || (data.image is string && data.image.size() <= 2048))
        && (!data.keys().hasAny(['sortOrder']) || data.sortOrder is number);
    }

    match /menu/{itemId} {
      allow read: if true;
      allow create, update: if isAdmin() && validMenuItem(itemId);
      allow delete: if isAdmin();
    }
  }
}
